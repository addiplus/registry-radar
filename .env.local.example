# Registry Radar environment variables. All values below are placeholders.
# Set real values in your local shell or Vercel project environment settings. Never commit real values.

# Upstash Redis via the Vercel KV integration. Used when BOTH are set.
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your-kv-rest-api-token

# Upstash Redis direct credentials. Used when the KV pair above is unset and BOTH are set.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-api-token

# Optional GitHub token. Raises the GitHub API rate limit from 60 requests per hour per IP.
GITHUB_TOKEN=your-github-personal-access-token

# When no Redis pair is set, the watchlist falls back to a local JSON file at
# .data/watchlist.json (or /tmp on Vercel, where pins and notes are ephemeral).
